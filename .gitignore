# Ignore node modules
node_modules
/*/node_modules

# Ignore the gitlab-ci-local working directory
.gitlab-ci-local/

# Ignore yarn
.yarn/
yarn-error.log

# Artefacts the functional test job writes (the tracked READMEs stay)
tests/reports/**/*.json
tests/reports/**/*.html
tests/reports/**/*.pdf
tests/reports/**/*.xml
tests/screenshots/**/*.png
tests/screenshots/**/*.jpeg
tests/videos/**/*.webm
.cucumber.js.bak

# Playwright MCP scratch output
.playwright-mcp/
